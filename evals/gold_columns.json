{
  "_about": {
    "purpose": "Baseline gold set for column -> FHIR R5 mapping. Stratified by how far the source schema sits from the curated knowledge base, because a single blended accuracy number hides the only thing users care about: what happens on a schema the KB has never seen.",
    "scoring": "Each entry lists ACCEPT, a set of defensible targets, not one string. The KB itself returns several valid destinations for many terms (submitter_id has 12 rows across 5 distinct resources), so single-string ground truth would score correct answers as wrong.",
    "label_provenance": {
      "gdc_native": "Taken from the knowledge base itself. Measures retrieval, not judgement: if the pipeline cannot return what is curated, nothing downstream can work.",
      "public_cohort": "Hand-assigned from FHIR R5 semantics and the project's own transformation rules.",
      "lab_native": "Hand-assigned. These are judgement calls; entries marked judgement=true are defensible rather than uniquely correct."
    },
    "created": "2026-09-15"
  },


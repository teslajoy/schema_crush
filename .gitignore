# ---------------------------------------------------------------------------
# schema_crush .gitignore
#
# the published repository ships source, curated mappings, calibrators, docs,
# and the tutorial. it deliberately excludes patient-level data, bulk
# downloads, vector stores, and generated reports.
# ---------------------------------------------------------------------------

# python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# virtual environments
venv/
venv313/
env/
ENV/
.venv

# testing
.pytest_cache/
.coverage
htmlcov/
*.cover

# ide / editor
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# type checkers and linters
.mypy_cache/
.ruff_cache/
.pytype/

# os
.DS_Store
Thumbs.db

# secrets
.env
.env.local

# logs, dev work-logs, and generated reports
*.log
results/
examples/reports/
markdown/
calibrators/*.md

# model and embedding caches
.cache/
models/
.ipynb_checkpoints/

# vector stores
vector_store/
chroma_db/

# ---------------------------------------------------------------------------
# data
#
# patient-level and bulk data never ships. the archive contains schema
# definitions and expert-curated mappings only.
# ---------------------------------------------------------------------------

# root-level scratch data (geo downloads, test datasets)
/data/

# project exports (htan/tcga ndjson, patient-level fhir)
schema_crush/data/examples/projects/
schema_crush/data/raw_content_maps/
schema_crush/data/hitl_queue/

# embeddings cache (regenerate with scripts/rebuild_and_recalibrate.py)
schema_crush/data/embeddings/

# sqlite: ship the curated flat mapping db, nothing else
schema_crush/data/db/*
!schema_crush/data/db/flat_mappings.db

# ---------------------------------------------------------------------------
# calibrators
#
# the packaged calibrators ship so `pip install` yields working calibrated
# confidence. the working copies under calibrators/ do not.
# ---------------------------------------------------------------------------
*.pkl
!schema_crush/data/calibrators/pkl/*.pkl
calibrators/calibration_logs/

# calibration summaries: ship the published result tables only
calibrators/summaries/*
!calibrators/summaries/calibration_summary.csv
!calibrators/summaries/embeddings_comparison.csv
!calibrators/summaries/flat_calibration_results.csv
!calibrators/summaries/flat_calibration_summary.csv

# ---------------------------------------------------------------------------
# scripts: maintenance tooling ships, its generated output does not
# ---------------------------------------------------------------------------
scripts/audit_output/

# ---------------------------------------------------------------------------
# demo: tutorial and walkthrough ship. the interactive umap html exports are
# ~4.6M each and are reproducible via demo/plot_agent_umap.py.
# ---------------------------------------------------------------------------
demo/*.html
demo/schema_crush_poster_V2.pdf

# ---------------------------------------------------------------------------
# examples: demos ship, ad-hoc tests and legacy experiments do not
# ---------------------------------------------------------------------------
examples/test_*.py
examples/legacy/
examples/*.png

# ---------------------------------------------------------------------------
# misc
# ---------------------------------------------------------------------------
legacy/
img/architecture.png
img/*.html
img/*.pptx
mappings_for_review.csv
# build artifacts
dist/

# eval outputs (the gold set is tracked, results are not)
evals/*.json
!evals/gold_columns.json
